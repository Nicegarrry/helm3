{
  "name": "helm",
  "private": true,
  "version": "1.7.1",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "helm": "./bin/helm.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=gc.auto GIT_CONFIG_VALUE_0=0 GIT_CONFIG_KEY_1=maintenance.auto GIT_CONFIG_VALUE_1=false tsx --test test/*.test.ts",
    "line-cap": "node scripts/line-cap.mjs",
    "helm": "tsx src/cli.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "1.3.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
